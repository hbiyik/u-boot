dfu_alt_info_ram=u-boot.img ram 60407fc0 300000;u-boot.bin ram 60408000 300000
set_dfu_alt_mem_boot=setenv dfu_alt_info "ram 0=dtb ram ${fdt_addr_r} 0x100000;kernel ram ${kernel_addr_r} 0x2000000;ramdisk ram ${ramdisk_addr_r} 0xBFFFFFF"
set_dfu_alt_mem=setenv dfu_alt_info "ram 0=loadaddr ram ${loadaddr} 0x2BC00000"
set_dfu_alt_flash=setenv dfu_alt_info "rkmtd 0=idbloader.img 64&ubi 0=u-boot.img vol u-boot;env vol env;rootfs.ubifs vol rootfs"
set_dfu_alt_idb=setenv dfu_alt_info "rkmtd 0=idbloader.img 64"
set_syslinux_ubi_boot=setenv syslinux_ubi_boot "sysboot ubi 0:rootfs any ${pxefile_addr_r} /boot/extlinux/extlinux.conf"
set_boot_mem=setenv bootargs "console=ttyS2,115200 earlycon=uart8250,mmio32,0x20064000 root=ubi0:rootfs rootfstype=ubifs ubi.mtd=ubi rw";setenv ramdisk_size ${dfu_ramdisk_filesize};bootz ${kernel_addr_r} ${ramdisk_addr_r}:${ramdisk_size} ${fdt_addr_r}
set_pr_bootmenu=echo completed without errors, run bootmenu to return to menu
set_ubi_recreate=ubi detach ubi; mtd erase ubi;ubi part ubi; ubi create u-boot 2F4000 static; ubi create env FC000 static; ubi create rootfs;
confirm_ubi_recreate=setenv confirm n; askenv confirm Are you sure you want to delete all the contents except idb in the flash? [y/N]: ; if test "$confirm" = "y"; then echo Proceeding...; run set_ubi_recreate; else echo Aborted.; fi
preboot=setenv dfu_bufsiz 0xfc000;rkmtd bind 0;run set_syslinux_ubi_boot;ubi part ubi;ubi part ubi;ubifsmount ubi0:rootfs;
bootcmd=bootflow scan; run syslinux_ubi_boot;
bootmenu_delay=5
bootmenu_default=0
bootmenu_0=Auto Boot=boot
bootmenu_1=Boot Kernel from memory via DFU over USB, rootfs from ubifs=run set_dfu_alt_mem_boot; echo Upload kernel(zImage), dtb and initramfs via dfu-util, and then detach dfu;dfu 0 list;dfu 0;run set_boot_mem;
bootmenu_2=Load/Restore All Flash via DFU over USB=run set_dfu_alt_flash; echo Upload/Download idbloader.img, env, u-boot.img or rootfs.ubifs via dfu-util;dfu 0 list; dfu 0;run set_pr_bootmenu;
bootmenu_3=Load/Restore IDB via DFU over USB=run set_dfu_alt_idb; echo Upload/Download idbloader.img via dfu-util;dfu 0 list; dfu 0;run set_pr_bootmenu;
bootmenu_4=Load/Restore RAM via DFU over USB=run set_dfu_alt_mem; echo Upload/Download loadaddr via dfu-util;dfu 0 list; dfu 0;run set_pr_bootmenu;
bootmenu_5=Erase and re-create UBI on flash=run confirm_ubi_recreate;run set_pr_bootmenu;